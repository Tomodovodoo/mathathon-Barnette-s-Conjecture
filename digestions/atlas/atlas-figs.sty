\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atlas-figs}[2026/11/14 extra encodings for the route atlas]
\RequirePackage{barnette-figs}
\usetikzlibrary{patterns,positioning,shapes.geometric,fit,backgrounds}
\tikzset{
  bf small/.style={bf D/.append style={line width=.8pt,-{Stealth[length=3pt,width=2.6pt]}},
    bf Q/.append style={line width=.8pt,dash pattern=on 2.2pt off 1.2pt},
    bf Qdir/.append style={line width=.8pt,-{Stealth[length=3pt,width=2.6pt]}},
    bf P/.append style={line width=1.2pt},bf cycle/.append style={line width=1pt},
    bf wtree/.append style={line width=.8pt},bf r/.append style={line width=.6pt},
    bf kept/.append style={line width=.8pt},bf edge/.append style={line width=.3pt}},
  af tint/.style={pattern=north east lines,pattern color=black!42},
  af tintb/.style={pattern=crosshatch dots,pattern color=black!55},
  af soft/.style={fill=bfS!19},
  af lab/.style={fill=white,inner sep=1pt,rounded corners=1pt,font=\footnotesize},
  af halo/.style={draw=white,line width=2.6pt},
  af bold/.style={draw=black,line width=1.5pt},
  af half/.style={draw=black,line width=1.1pt,dash pattern=on 2.4pt off 1.6pt},
  af stub/.style={draw=black!70,line width=1.4pt,dash pattern=on 1pt off 2pt},
  af note/.style={font=\footnotesize,align=left},
}
