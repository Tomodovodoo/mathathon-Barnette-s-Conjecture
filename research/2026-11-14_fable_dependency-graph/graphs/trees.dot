digraph "trees" {
  rankdir=TB;
  label="A constructive proof of Barnette's conjecture"; labelloc=t;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  HYP [label="G cubic, bipartite, planar, 3-connected, edge e", role="side", classification="hypothesis", status="discharged", layer=0, fillcolor="#f3e3ea", color="#8b2252", style="rounded,filled,dotted"];
  O1 [label="T = G* simple triangulation, 2-coloured, counts (2)", role="core", classification="proved earlier", status="discharged", layer=1, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  E3 [label="(3): H - s tree iff Q_s rooted forest", role="core", classification="algebraic/logical step", status="discharged", layer=2, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C21 [label="Prop 2.1: mates, 2^k, unique mate iff tree matching", role="extra", classification="proved earlier", status="discharged", layer=2, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed"];
  S6 [label="S6, S7: balance-1 triangle is a face; region of t0 costs one [no black-inner triangle]", role="side", classification="hypothesis", status="discharged", layer=2, fillcolor="#f3e3ea", color="#8b2252", style="rounded,filled,dotted"];
  S3 [label="S3: a black-inner triangle violates (5) by one", role="extra", classification="algebraic/logical step", status="discharged", layer=2, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed"];
  C41 [label="Lemma 4.1: disk identity, odd length", role="core", classification="major claim", status="discharged", layer=2, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  F23 [label="Section 3: (ii) iff (iii)", role="core", classification="major claim", status="discharged", layer=3, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C42 [label="Lemma 4.2: every exchange reverses epsilon", role="core", classification="major claim", status="discharged", layer=3, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C51 [label="Lemma 5.1: integer weights, L+ > L-", role="core", classification="proved earlier", status="discharged", layer=3, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C61 [label="Lemma 6.1: one permutation sign, M = |det K_B| <= 3^{n/2}", role="extra", classification="proved earlier", status="discharged", layer=3, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed"];
  C52 [label="Theorem 5.2: a tree pair in every exchange component", role="core", classification="major claim", status="discharged", layer=4, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C53 [label="Theorem 5.3: marked walk (two involutions)", role="extra", classification="major claim", status="discharged", layer=4, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed"];
  C12 [label="Theorem 1.2: incidence-tree criterion", role="core", classification="major claim", status="discharged", layer=5, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  P62 [label="Prop 6.2: prefix enumeration", role="extra", classification="proved earlier", status="discharged", layer=6, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed"];
  L71 [label="Lemma 7.1: white tree, P forest, two induced trees", role="core", classification="major claim", status="discharged", layer=6, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  G73 [label="7.3: cut only at black-inner triangles, glue", role="core", classification="proved earlier", status="discharged", layer=7, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  TB [label="time bound O(poly(N) 3^{N/4})", role="extra", classification="algebraic/logical step", status="discharged", layer=7, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed"];
  C0 [label="Theorem 1.1", role="core", classification="root", status="discharged", layer=8, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  XC [label="companion: BFS and random-walk constructors (not supplied)", role="extra", classification="missing", status="open", layer=9, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed", peripheries=2];
  { rank=same; HYP; }
  { rank=same; O1; }
  { rank=same; E3; C21; S6; S3; C41; }
  { rank=same; F23; C42; C51; C61; }
  { rank=same; C52; C53; }
  { rank=same; C12; }
  { rank=same; P62; L71; }
  { rank=same; G73; TB; }
  { rank=same; C0; }
  { rank=same; XC; }
  HYP -> O1;
  O1 -> E3;
  O1 -> S6;
  O1 -> S3;
  O1 -> C41;
  S6 -> F23;
  S3 -> F23;
  C41 -> C42;
  C21 -> C42;
  C41 -> C61;
  C42 -> C52;
  C51 -> C52;
  C21 -> C52;
  E3 -> C52;
  C42 -> C53;
  C51 -> C53;
  E3 -> C12;
  C21 -> C12;
  F23 -> C12;
  C52 -> C12;
  C12 -> P62;
  C61 -> P62;
  C41 -> L71;
  C12 -> G73;
  L71 -> G73;
  P62 -> C0;
  G73 -> C0;
  C61 -> TB;
  TB -> C0;
  C53 -> XC;
}
