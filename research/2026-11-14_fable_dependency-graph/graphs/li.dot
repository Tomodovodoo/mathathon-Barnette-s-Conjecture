digraph "li" {
  rankdir=TB;
  label="Li: A note on the proof of Barnette's conjecture"; labelloc=t;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  HYP [label="G Barnette graph, e0 = b0 w0", role="side", classification="hypothesis", status="discharged", layer=0, fillcolor="#f3e3ea", color="#8b2252", style="rounded,filled,dotted"];
  E0 [label="E0: straight-line drawing of aux(G), general position (undefined in the note)", role="packaging", classification="side condition", status="discharged", layer=1, fillcolor="#eeeeee", color="#555555", style="rounded,filled,dashed"];
  Q1a [label="Q1a: |B'| = |F'| (not stated)", role="side", classification="side condition", status="discharged", layer=1, fillcolor="#f3e3ea", color="#8b2252", style="rounded,filled,dotted"];
  Q1 [label="Theorem 10 (Ore): deficit condition", role="core", classification="named theorem", status="discharged", layer=2, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  Q7 [label="Q2-Q7: minimal deficient S gives a non-trivial 3-edge cut [cyclic 4-edge-conn.]", role="variant", classification="hypothesis", status="discharged", layer=2, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  C6 [label="Lemma 9: Li's H has a 2-factor", role="core", classification="major claim", status="discharged", layer=3, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C25 [label="Claim 25: t_out - t_in = 3 (disk identity)", role="core", classification="major claim", status="discharged", layer=3, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C26 [label="Claim 26: cw' as a sum of local turns", role="core", classification="proved earlier", status="discharged", layer=4, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C16 [label="Lemma 16: swap along a cycle of M1 u M2 flips cw", role="core", classification="algebraic/logical step", status="discharged", layer=4, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  I3 [label="iota_2: pair consecutive ray crossings", role="variant", classification="algebraic/logical step", status="discharged", layer=4, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  C17 [label="Lemma 17: swap along a cycle of H - M2 flips cw", role="core", classification="major claim", status="discharged", layer=5, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  I1 [label="iota_1 and Lemma 34: flip the first cycle of H - M2", role="core", classification="proved earlier", status="discharged", layer=6, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  I4 [label="Lemma 35: iota_2 reverses the sign", role="variant", classification="proved earlier", status="discharged", layer=6, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  I5 [label="Lemma 24: fixed points of iota_2 share a sign, and exist", role="variant", classification="proved earlier", status="discharged", layer=6, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  B [label="Appendix B: c_min > 1 (sketch, three steps supplied in the audit)", role="variant", classification="major claim", status="discharged", layer=6, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  C2 [label="Lemma 7 (Key Lemma): cycle-breaking 2-factor", role="core", classification="major claim", status="discharged", layer=7, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C3 [label="Lemma 8: G_FB - M2 is a spanning tree", role="core", classification="major claim", status="discharged", layer=8, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C4 [label="Corollary 27: white tree T_W = M2*", role="core", classification="named theorem", status="discharged", layer=9, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  T2 [label="Claim 31: P is a perfect matching of G", role="core", classification="algebraic/logical step", status="discharged", layer=10, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C5 [label="Lemma 30: E(G) - P is one cycle (innermost cycle, no disk identity)", role="variant", classification="major claim", status="discharged", layer=11, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  C1 [label="Theorem 4", role="core", classification="major claim", status="discharged", layer=12, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  A [label="Appendix C: non-trivial 3-edge cuts, contraction and gluing", role="core", classification="proved earlier", status="discharged", layer=12, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C0 [label="Theorem 3", role="core", classification="root", status="discharged", layer=13, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  { rank=same; HYP; }
  { rank=same; E0; Q1a; }
  { rank=same; Q1; Q7; }
  { rank=same; C6; C25; }
  { rank=same; C26; C16; I3; }
  { rank=same; C17; }
  { rank=same; I1; I4; I5; B; }
  { rank=same; C2; }
  { rank=same; C3; }
  { rank=same; C4; }
  { rank=same; T2; }
  { rank=same; C5; }
  { rank=same; C1; A; }
  { rank=same; C0; }
  HYP -> E0;
  HYP -> Q1a;
  HYP -> Q7;
  Q1a -> Q1;
  Q1 -> C6;
  Q7 -> C6;
  E0 -> C25;
  C25 -> C26;
  C25 -> C17;
  C26 -> C17;
  C17 -> I1;
  E0 -> I3;
  I3 -> I4;
  C16 -> I4;
  I3 -> I5;
  C16 -> B;
  I3 -> B;
  C6 -> C2;
  I1 -> C2;
  I4 -> C2;
  I5 -> C2;
  B -> C2;
  C2 -> C3;
  C3 -> C4;
  C4 -> T2;
  T2 -> C5;
  C5 -> C1;
  C1 -> C0;
  A -> C0;
  HYP -> A;
}
