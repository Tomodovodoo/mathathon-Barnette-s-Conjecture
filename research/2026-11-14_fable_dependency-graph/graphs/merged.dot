digraph "merged" {
  rankdir=TB;
  label="Merged dependency graph of the three proofs"; labelloc=t;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  HYP [label="Hypotheses: G cubic, bipartite, planar, 3-connected", role="side", classification="hypothesis", status="discharged", layer=0, fillcolor="#f3e3ea", color="#8b2252", style="rounded,filled,dotted"];
  K0 [label="K0 rooted Eulerian triangulation: T simple, 2-coloured, t0, e0\nO: O1,O2 | L: aux(G), b0 w0 | T: O1", role="core", classification="proved earlier", status="discharged", layer=1, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K1 [label="K1 balanced incidence graph B, |A| = |X| = n\nO: (2.1) | L: unstated (Q1a) | T: (2)", role="core", classification="algebraic/logical step", status="discharged", layer=2, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K3 [label="K3 disk identity\nO: Lemma 4.1 | L: Claim 25 | T: Lemma 4.1", role="core", classification="major claim", status="discharged", layer=2, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K10a [label="plane-tree duality\nO: Lemma 2.1 | L: tree-cotree | T: 7.1", role="core", classification="named theorem", status="discharged", layer=2, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  V2a [label="density bound on every component of T[U]\n[no separating triangle]  O: P5-P9", role="variant", classification="side condition", status="discharged", layer=3, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  V2b [label="minimal deficient set gives a 3-edge cut\n[cyclic 4-edge-connected]  L: Q2-Q7", role="variant", classification="side condition", status="discharged", layer=3, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  V2c [label="exact: region of t0 treated apart\n[no black-inner triangle], with converse  T: S3-S9", role="variant", classification="side condition", status="discharged", layer=3, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  K2 [label="K2 two disjoint states exist (a pair)\nO: Prop 3.1 | L: Lemma 9 | T: Section 3", role="core", classification="major claim", status="discharged", layer=4, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K4 [label="K4 sign of a pair; D-reversal and Q_s-reversal both flip it\nO: (5.1), Lemma 5.2 | L: Lemmas 16, 17 | T: Lemma 4.2", role="core", classification="major claim", status="discharged", layer=4, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  V5a [label="unit circulation by dual paths + slide onto spokes\nO: Lemma 5.3 | T: Lemma 5.1", role="variant", classification="proved earlier", status="discharged", layer=4, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  V5b [label="vertical rays from white vertices in a straight-line drawing\nL: Remark 19, Definition 20", role="variant", classification="proved earlier", status="discharged", layer=4, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  K5 [label="K5 weights with L+(C) > L-(C) on every D-cycle", role="core", classification="proved earlier", status="discharged", layer=5, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K6 [label="K6 cancellation for fixed s (reverse a cycle of Q_s)\nO: Lemma 5.2 | L: iota_1 | T: beta", role="core", classification="major claim", status="discharged", layer=5, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  V7a [label="Taylor coefficient of order c_min of Z(x)\nO: (5.4), (5.5)", role="variant", classification="algebraic/logical step", status="discharged", layer=6, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  V7b [label="iota_2: fixed points of one sign, c_min marks\nL: Lemmas 24, 35, App. B", role="variant", classification="algebraic/logical step", status="discharged", layer=6, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  V7c [label="coefficient of (z-1)^m of Z_C(z), per component\nT: Theorem 5.2", role="variant", classification="algebraic/logical step", status="discharged", layer=6, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  V7d [label="marked walk, restart with two fewer cycles\nT: Theorem 5.3", role="extra", classification="algebraic/logical step", status="discharged", layer=6, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed"];
  K7 [label="K7 the grouped count is not zero:\nsum over D with fewest cycles of prod (L+ - L-) > 0", role="core", classification="major claim", status="discharged", layer=7, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K8 [label="K8 a pair with Q_s a forest = tree matching s (H - s spanning tree)\nO: Prop 5.1, Lemma 6.1 | L: Lemmas 7, 8 | T: Thm 5.2, (3), Prop 2.1", role="core", classification="major claim", status="discharged", layer=8, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K10 [label="K10 white tree: dual of the deleted spokes\nO: 6.1 | L: Cor 27 | T: 7.1", role="core", classification="proved earlier", status="discharged", layer=9, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K11 [label="K11 selected set P: one side per face of T = perfect matching of G\nO: 6.1 | L: Claim 31 | T: 7.1", role="core", classification="algebraic/logical step", status="discharged", layer=10, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  V12a [label="P is a forest: selected-side count against the disk identity\nO: Lemma 6.2 | T: Lemma 7.1", role="variant", classification="major claim", status="discharged", layer=11, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  V12b [label="innermost root-free cycle, out-degree-one walk on a tree of faces\nL: Lemma 30", role="variant", classification="major claim", status="discharged", layer=11, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  K12 [label="K12 E(G) - P is a Hamiltonian cycle avoiding e0\n(O, T: equivalently two induced trees of T)", role="core", classification="major claim", status="discharged", layer=12, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K15 [label="K15 cut along a separating triangle / 3-edge cut, prescribe the cap edge, glue\nO: Section 7 | L: App. C | T: 7.3 (black-inner only)", role="core", classification="major claim", status="discharged", layer=12, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  K16 [label="Barnette's conjecture, with a prescribed avoided edge\nO: Thm 1.1, Cor 7.1 | L: Thm 3 | T: Thm 1.1", role="core", classification="root", status="discharged", layer=13, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  X1 [label="T only: Prop 2.1, s is a tree matching iff it has exactly one mate", role="extra", classification="proved earlier", status="discharged", layer=8, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed"];
  X2 [label="T only: Lemma 6.1, all states have one permutation sign; enumeration, 3^{n/2}", role="extra", classification="proved earlier", status="discharged", layer=5, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed"];
  X3 [label="O only: Corollary 7.2 (cited theorem, open)", role="extra", classification="named theorem", status="open", layer=14, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed", peripheries=2];
  { rank=same; HYP; }
  { rank=same; K0; }
  { rank=same; K1; K3; K10a; }
  { rank=same; V2a; V2b; V2c; }
  { rank=same; K2; K4; V5a; V5b; }
  { rank=same; K5; K6; X2; }
  { rank=same; V7a; V7b; V7c; V7d; }
  { rank=same; K7; }
  { rank=same; K8; X1; }
  { rank=same; K10; }
  { rank=same; K11; }
  { rank=same; V12a; V12b; }
  { rank=same; K12; K15; }
  { rank=same; K16; }
  { rank=same; X3; }
  HYP -> K0;
  K0 -> K1;
  K0 -> K3;
  K1 -> V2a;
  K1 -> V2b;
  K1 -> V2c;
  V2a -> K2;
  V2b -> K2;
  V2c -> K2;
  K3 -> K4;
  K3 -> X2;
  V5a -> K5;
  V5b -> K5;
  K4 -> K6;
  K2 -> V7a;
  K2 -> V7b;
  K2 -> V7c;
  K5 -> V7a;
  K5 -> V7b;
  K5 -> V7c;
  K5 -> V7d;
  K4 -> V7a;
  K4 -> V7b;
  K4 -> V7c;
  K4 -> V7d;
  V7a -> K7;
  V7b -> K7;
  V7c -> K7;
  V7d -> K7;
  K6 -> K8;
  K7 -> K8;
  K8 -> X1;
  K8 -> K10;
  K10a -> K10;
  K10 -> K11;
  K11 -> V12a;
  K11 -> V12b;
  K3 -> V12a;
  V12a -> K12;
  V12b -> K12;
  K12 -> K16;
  K15 -> K16;
  K0 -> K15;
  K16 -> X3;
}
