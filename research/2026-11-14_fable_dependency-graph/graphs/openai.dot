digraph "openai" {
  rankdir=TB;
  label="OpenAI: Paired states and Hamiltonian cycles"; labelloc=t;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  HYP [label="G cubic, bipartite, planar, 3-connected", role="side", classification="hypothesis", status="discharged", layer=0, fillcolor="#f3e3ea", color="#8b2252", style="rounded,filled,dotted"];
  O1 [label="O1, O2: T = G* simple triangulation, faces 2-coloured", role="core", classification="proved earlier", status="discharged", layer=1, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  E1 [label="(2.1): |A| = |X| = k - 1", role="core", classification="algebraic/logical step", status="discharged", layer=2, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  L21 [label="Lemma 2.1: plane-tree duality", role="core", classification="proved earlier", status="discharged", layer=2, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  P5 [label="P5: triangular faces of K are faces of T [no separating triangle]", role="side", classification="side condition", status="discharged", layer=2, fillcolor="#f3e3ea", color="#8b2252", style="rounded,filled,dotted"];
  C3 [label="Prop 3.1: a pair exists (flow + density bound)", role="core", classification="major claim", status="discharged", layer=3, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C4 [label="Lemma 4.1: disk identity", role="core", classification="major claim", status="discharged", layer=3, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C53 [label="Lemma 5.3: unit spoke circulations", role="variant", classification="proved earlier", status="discharged", layer=3, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  N2 [label="(5.1): J integer, J = #cw - #ccw", role="core", classification="proved earlier", status="discharged", layer=4, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C52 [label="Lemma 5.2: cancellation for fixed s", role="core", classification="major claim", status="discharged", layer=4, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  N3 [label="5.3: regroup pairs by undirected D", role="core", classification="algebraic/logical step", status="discharged", layer=4, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  N4c [label="N4b, N4c: spoke detour is a simple ccw cycle (slide)", role="packaging", classification="side condition", status="discharged", layer=4, fillcolor="#eeeeee", color="#555555", style="rounded,filled,dashed"];
  N4 [label="(5.3): L+(C) > L-(C)", role="core", classification="proved earlier", status="discharged", layer=5, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  N7 [label="N6, N7: Taylor coefficient of order c_min is nonzero", role="variant", classification="algebraic/logical step", status="discharged", layer=6, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  C5 [label="Prop 5.1: a pair with Q_s a forest", role="core", classification="major claim", status="discharged", layer=7, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C61 [label="Lemma 6.1: one root per component of Q_s", role="core", classification="proved earlier", status="discharged", layer=8, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  W [label="6.1: H - s spanning tree, white tree, selected set P", role="core", classification="proved earlier", status="discharged", layer=9, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C62 [label="Lemma 6.2: P is a forest (disk identity for s)", role="variant", classification="major claim", status="discharged", layer=10, fillcolor="#fdf3d0", color="#8a6d00", style="rounded,filled"];
  S [label="6.2: dual cycle, two induced trees, pattern at t0", role="core", classification="proved earlier", status="discharged", layer=11, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C1b [label="Theorem 2.2 without separating triangles", role="core", classification="major claim", status="discharged", layer=12, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C1g [label="Section 7: gluing over a separating triangle", role="core", classification="major claim", status="discharged", layer=12, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C1 [label="Theorem 2.2", role="core", classification="major claim", status="discharged", layer=13, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  O3 [label="O3: two induced trees give a Hamiltonian cycle", role="core", classification="proved earlier", status="discharged", layer=13, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  C0 [label="Theorem 1.1 and Corollary 7.1", role="core", classification="root", status="discharged", layer=14, fillcolor="#dbe9f6", color="#1f4e79", style="rounded,filled"];
  X72 [label="Corollary 7.2 (needs [5, Thm 4.16], not opened)", role="extra", classification="named theorem", status="open", layer=15, fillcolor="#e4f1e0", color="#2f6b2f", style="rounded,filled,dashed", peripheries=2];
  { rank=same; HYP; }
  { rank=same; O1; }
  { rank=same; E1; L21; P5; }
  { rank=same; C3; C4; C53; }
  { rank=same; N2; C52; N3; N4c; }
  { rank=same; N4; }
  { rank=same; N7; }
  { rank=same; C5; }
  { rank=same; C61; }
  { rank=same; W; }
  { rank=same; C62; }
  { rank=same; S; }
  { rank=same; C1b; C1g; }
  { rank=same; C1; O3; }
  { rank=same; C0; }
  { rank=same; X72; }
  HYP -> O1;
  O1 -> E1;
  O1 -> P5;
  E1 -> C3;
  P5 -> C3;
  O1 -> C4;
  C4 -> N2;
  C4 -> C52;
  C4 -> C62;
  C53 -> N4;
  N4c -> N4;
  N2 -> N7;
  N3 -> N7;
  N4 -> N7;
  C3 -> C5;
  C52 -> C5;
  N7 -> C5;
  C5 -> C61;
  C61 -> W;
  L21 -> W;
  W -> C62;
  C62 -> S;
  L21 -> S;
  S -> C1b;
  C1b -> C1;
  C1g -> C1;
  O1 -> C1g;
  C1 -> C0;
  O3 -> C0;
  L21 -> O3;
  C0 -> X72;
}
