'OAI.Barnette.main' depends on axioms: [propext, Classical.choice, Quot.sound]
OAI.Barnette.main : OAI.Barnette.MainStatement
def OAI.Barnette.MainStatement.{u} : Prop :=
∀ (V : Type u) [inst : Fintype V] [inst_1 : DecidableEq V] (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj],
  G.IsRegularOfDegree 3 →
    G.IsBipartite → OAI.Barnette.Planar G → OAI.Barnette.ThreeVertexConnected G → OAI.Barnette.HasHamiltonianCycle G
'OAI.Barnette.Network.Duality.connected_complement_matching' depends on axioms: [propext, Classical.choice, Quot.sound]
'OAI.Barnette.PlaneEmbedding.exists_exact_dual' depends on axioms: [propext, Classical.choice, Quot.sound]
'OAI.Barnette.Network.ColoredDual.forest_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
