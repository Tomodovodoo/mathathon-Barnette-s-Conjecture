@[reducible] def SimpleGraph.IsBipartite.{u_1} : {V : Type u_1} → SimpleGraph V → Prop :=
fun {V} G => G.Colorable 2
def SimpleGraph.Colorable.{u} : {V : Type u} → SimpleGraph V → ℕ → Prop :=
fun {V} G n => Nonempty (G.Coloring (Fin n))
def SimpleGraph.IsRegularOfDegree.{u_1} : {V : Type u_1} → (G : SimpleGraph V) → [G.LocallyFinite] → ℕ → Prop :=
fun {V} G [G.LocallyFinite] d => ∀ (v : V), G.degree v = d
structure SimpleGraph.Walk.IsHamiltonianCycle.{u_1} {α : Type u_1} [DecidableEq α] {G : SimpleGraph α} {a : α}
  (p : G.Walk a a) : Prop
number of parameters: 5
parents:
  SimpleGraph.Walk.IsHamiltonianCycle.toIsCycle : p.IsCycle
fields:
  SimpleGraph.Walk.IsTrail.edges_nodup : p.edges.Nodup
  SimpleGraph.Walk.IsCircuit.ne_nil : p ≠ SimpleGraph.Walk.nil
  SimpleGraph.Walk.IsCycle.support_nodup : p.support.tail.Nodup
  SimpleGraph.Walk.IsHamiltonianCycle.isHamiltonian_tail : p.tail.IsHamiltonian
constructor:
  SimpleGraph.Walk.IsHamiltonianCycle.mk.{u_1} {α : Type u_1} [DecidableEq α] {G : SimpleGraph α} {a : α}
    {p : G.Walk a a} (toIsCycle : p.IsCycle) (isHamiltonian_tail : p.tail.IsHamiltonian) : p.IsHamiltonianCycle
field notation resolution order:
  SimpleGraph.Walk.IsHamiltonianCycle, SimpleGraph.Walk.IsCycle, SimpleGraph.Walk.IsCircuit, SimpleGraph.Walk.IsTrail
def SimpleGraph.Walk.IsHamiltonian.{u_1} : {α : Type u_1} →
  [DecidableEq α] → {G : SimpleGraph α} → {a b : α} → G.Walk a b → Prop :=
fun {α} [DecidableEq α] {G} {a b} p => ∀ (a_1 : α), List.count a_1 p.support = 1
structure SimpleGraph.Walk.IsCycle.{u} {V : Type u} {G : SimpleGraph V} {u : V} (p : G.Walk u u) : Prop
number of parameters: 4
parents:
  SimpleGraph.Walk.IsCycle.isCircuit : p.IsCircuit
fields:
  SimpleGraph.Walk.IsTrail.edges_nodup : p.edges.Nodup
  SimpleGraph.Walk.IsCircuit.ne_nil : p ≠ SimpleGraph.Walk.nil
  SimpleGraph.Walk.IsCycle.support_nodup : p.support.tail.Nodup
constructor:
  SimpleGraph.Walk.IsCycle.mk.{u} {V : Type u} {G : SimpleGraph V} {u : V} {p : G.Walk u u} (isCircuit : p.IsCircuit)
    (support_nodup : p.support.tail.Nodup) : p.IsCycle
field notation resolution order:
  SimpleGraph.Walk.IsCycle, SimpleGraph.Walk.IsCircuit, SimpleGraph.Walk.IsTrail
structure SimpleGraph.Connected.{u} {V : Type u} (G : SimpleGraph V) : Prop
number of parameters: 2
fields:
  SimpleGraph.Connected.preconnected : G.Preconnected
  SimpleGraph.Connected.nonempty : Nonempty V
constructor:
  SimpleGraph.Connected.mk.{u} {V : Type u} {G : SimpleGraph V} (preconnected : G.Preconnected)
    [nonempty : Nonempty V] : G.Connected
@[reducible] def SimpleGraph.induce.{u_1} : {V : Type u_1} → (s : Set V) → SimpleGraph V → SimpleGraph ↑s :=
fun {V} s G => SimpleGraph.comap (⇑(Function.Embedding.subtype fun x => x ∈ s)) G
structure Path.{u_1} {X : Type u_1} [TopologicalSpace X] (x y : X) : Type u_1
number of parameters: 4
parents:
  Path.toContinuousMap : C(↑unitInterval, X)
fields:
  ContinuousMap.toFun : ↑unitInterval → X
  ContinuousMap.continuous_toFun : Continuous self.toFun := by
    fun_prop
  Path.source' : self.toFun 0 = x
  Path.target' : self.toFun 1 = y
constructor:
  Path.mk.{u_1} {X : Type u_1} [TopologicalSpace X] {x y : X} (toContinuousMap : C(↑unitInterval, X))
    (source' : toContinuousMap.toFun 0 = x) (target' : toContinuousMap.toFun 1 = y) : Path x y
field notation resolution order:
  Path, ContinuousMap
@[reducible] def unitInterval : Set ℝ :=
Set.Icc 0 1
