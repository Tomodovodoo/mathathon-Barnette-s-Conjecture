@Blueprint.finite_difference : ∀ {ι : Type u_1} {R : Type u_2} [DecidableEq ι] [inst : CommRing R] (L : ι → R)
  (s : Finset ι),
  (∀ (a : R), ∀ m < s.card, Blueprint.F L s a m = 0) ∧
    ∀ (a : R), Blueprint.F L s a s.card = (-1) ^ s.card * ↑s.card.factorial * ∏ i ∈ s, L i
@Blueprint.finite_difference_fin : ∀ {R : Type u_1} [inst : CommRing R] (c : ℕ) (ω₀ : R) (L : Fin c → R),
  (∀ m < c, ∑ S ∈ Finset.univ.powerset, (-1) ^ S.card * (ω₀ + ∑ i ∈ S, L i) ^ m = 0) ∧
    ∑ S ∈ Finset.univ.powerset, (-1) ^ S.card * (ω₀ + ∑ i ∈ S, L i) ^ c = (-1) ^ c * ↑c.factorial * ∏ i, L i
@prod_sum_of_signs : ∀ {ι : Type u_1} (S : Finset ι) (f : ι → ℤ),
  (∀ i ∈ S, f i = 1 ∨ f i = -1) →
    ∏ i ∈ S, f i = (-1) ^ {i ∈ S | f i = -1}.card ∧ ↑S.card = ∑ i ∈ S, f i + 2 * ↑{i ∈ S | f i = -1}.card
@OppositeCycle.paperSign_reverse : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V} {s : T.State X}
  (C : T.OppositeCycle s) [inst : Fintype A] (r : T.State X) (hrs : T.Partner r s),
  C.cyclicDelta r = 3 ∨ C.cyclicDelta r = -3 → paperSign (C.reverse r hrs) s = -paperSign r s
@OppositeCycle.paperSign_partners_sum : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V}
  {s : T.State X} (C : T.OppositeCycle s) [inst : Fintype A] {M : Type u_3} [inst_1 : AddCommGroup M],
  (∀ (r : Partners s), C.cyclicDelta ↑r = 3 ∨ C.cyclicDelta ↑r = -3) →
    ∀ (weight : M), ∑ r, paperSign (↑r) s • weight = 0
@Pair.sign_orient : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V} [inst : Fintype A]
  (P : Pair X),
  (∀ (c : CycleClass P.next), P.cycleDelta c = 3 ∨ P.cycleDelta c = -3) →
    ∀ (b : CycleClass P.next → Bool), (↑(P.orient b)).sign = (-1) ^ {c | b c = true}.card * P.sign
@Pair.sign_reverse_one : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V} [inst : Fintype A]
  (P : Pair X),
  (∀ (c : CycleClass P.next), P.cycleDelta c = 3 ∨ P.cycleDelta c = -3) →
    ∀ (c : CycleClass P.next) (b : CycleClass P.next → Bool),
      (∀ (c' : CycleClass P.next), b c' = true ↔ c' = c) → (↑(P.orient b)).sign = -P.sign
@Pair.sign_formula : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V} [inst : Fintype A]
  (P : Pair X),
  (∀ (c : CycleClass P.next), P.cycleDelta c = 3 ∨ P.cycleDelta c = -3) →
    Even (Fintype.card A + Fintype.card (CycleClass P.next)) ∧
      P.sign = (-1) ^ ((Fintype.card A + Fintype.card (CycleClass P.next)) / 2 + P.ccwCount)
@Pair.I_zpow_rawIndexSum : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V} [inst : Fintype A]
  {r s : T.State X}, T.Partner r s → Complex.I ^ rawIndexSum r s = Complex.I ^ Fintype.card A * ↑(paperSign r s)
@Pair.phase_eq_paperSign : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V} [inst : Fintype A]
  {r s : T.State X},
  T.Partner r s → 3 ∣ rawIndexSum r s → phase (rawIndexSum r s) = Complex.I ^ (-↑(Fintype.card A)) * ↑(paperSign r s)
@Pair.paperSign_eq_I_pow_mul_phase : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V}
  [inst : Fintype A] {r s : T.State X},
  T.Partner r s → 3 ∣ rawIndexSum r s → ↑(paperSign r s) = Complex.I ^ Fintype.card A * phase (rawIndexSum r s)
@Pair.three_dvd_rawIndexSum : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V} [inst : Fintype A]
  (P : Pair X), (∀ (c : CycleClass P.next), P.cycleDelta c = 3 ∨ P.cycleDelta c = -3) → 3 ∣ rawIndexSum P.left P.right
@Pair.sign_eq_I_pow_mul_phase : ∀ {A : Type u_1} {V : Type u_2} {T : TriangleSystem A V} {X : Set V} [inst : Fintype A]
  (P : Pair X),
  (∀ (c : CycleClass P.next), P.cycleDelta c = 3 ∨ P.cycleDelta c = -3) →
    ↑P.sign = Complex.I ^ Fintype.card A * phase (rawIndexSum P.left P.right)
@Pair.sum_sign_eq_zero_of_no_good : ∀ {A : Type u_1} {V : Type u_2} [inst : Fintype A] {T : TriangleSystem A V}
  {X : Set V},
  (∀ (s : T.State X) (C : T.OppositeCycle s) (r : Partners s), C.cyclicDelta ↑r = 3 ∨ C.cyclicDelta ↑r = -3) →
    (∀ (P : Pair X), ¬(T.oppositeGraph P.right).IsAcyclic) → ∀ (F : T.State X → ℝ), ∑ P, ↑P.sign * F P.right = 0
@Pair.weight_orient : ∀ {A : Type u_1} {V : Type u_2} [inst : Fintype A] {T : TriangleSystem A V} {X : Set V}
  (P : Pair X) (w : A → Fin 3 → ℝ) (b : CycleClass P.next → Bool),
  weight w (↑(P.orient b)).right = weight w P.right + ∑ c with b c = true, P.step w c
@Pair.group_sum : ∀ {A : Type u_1} {V : Type u_2} [inst : Fintype A] {T : TriangleSystem A V} {X : Set V} (P : Pair X),
  (∀ (c : CycleClass P.next), P.cycleDelta c = 3 ∨ P.cycleDelta c = -3) →
    ∀ (w : A → Fin 3 → ℝ) (m : ℕ),
      ∑ Q, ↑(↑Q).sign * weight w (↑Q).right ^ m = ↑P.sign * Blueprint.F (P.step w) Finset.univ (weight w P.right) m
@Pair.group_sum_card : ∀ {A : Type u_1} {V : Type u_2} [inst : Fintype A] {T : TriangleSystem A V} {X : Set V}
  (P : Pair X) (w : A → Fin 3 → ℝ),
  (∀ (c : CycleClass P.next), P.cycleDelta c = -3 ∧ 0 < P.cycleSlope w c ∨ P.cycleDelta c = 3 ∧ P.cycleSlope w c < 0) →
    ∑ Q, ↑(↑Q).sign * weight w (↑Q).right ^ Fintype.card (CycleClass P.next) =
      (-1) ^ ((Fintype.card A + Fintype.card (CycleClass P.next)) / 2 + Fintype.card (CycleClass P.next)) *
          ↑(Fintype.card (CycleClass P.next)).factorial *
        ∏ c, |P.cycleSlope w c|
@Pair.group_sum_lt : ∀ {A : Type u_1} {V : Type u_2} [inst : Fintype A] {T : TriangleSystem A V} {X : Set V}
  (P : Pair X),
  (∀ (c : CycleClass P.next), P.cycleDelta c = 3 ∨ P.cycleDelta c = -3) →
    ∀ (w : A → Fin 3 → ℝ) {m : ℕ}, m < Fintype.card (CycleClass P.next) → ∑ Q, ↑(↑Q).sign * weight w (↑Q).right ^ m = 0
@Pair.realSum_ne_zero : ∀ {A : Type u_1} {V : Type u_2} [inst : Fintype A] {T : TriangleSystem A V} {X : Set V}
  (hex : Nonempty (Pair X)) (w : A → Fin 3 → ℝ),
  (∀ (P : Pair X) (c : CycleClass P.next),
      P.cycleDelta c = -3 ∧ 0 < P.cycleSlope w c ∨ P.cycleDelta c = 3 ∧ P.cycleSlope w c < 0) →
    realSum w (Pair.minCycles hex) ≠ 0
@Pair.forest_pair_of_disk_circulation_real : ∀ {A : Type u_1} {V : Type u_2} [inst : Fintype A] {T : TriangleSystem A V}
  {X : Set V},
  Nonempty (Pair X) →
    (∀ (s : T.State X) (C : T.OppositeCycle s) (r : Partners s), C.cyclicDelta ↑r = 3 ∨ C.cyclicDelta ↑r = -3) →
      ∀ (w : A → Fin 3 → ℝ),
        (∀ (P : Pair X) (c : CycleClass P.next),
            P.cycleDelta c = -3 ∧ 0 < P.cycleSlope w c ∨ P.cycleDelta c = 3 ∧ P.cycleSlope w c < 0) →
          ∃ P, (T.oppositeGraph P.right).IsAcyclic
@sign_reverse_opposite : ∀ {V : Type u_1} {E : Type u_2} {F : Type u_3} [inst : Fintype V] [inst_1 : Fintype E]
  [Fintype F] {N : Network V E} {D : Network F E} (M : N.ColoredDual D) {root : V} {s r : M.State root}
  (C : (M.system root).OppositeCycle s) (hrs : (M.system root).Partner r s),
  paperSign (C.reverse r hrs) s = -paperSign r s
@sign_orient_concrete : ∀ {V : Type u_1} {E : Type u_2} {F : Type u_3} [inst : Fintype V] [inst_1 : Fintype E]
  [Fintype F] {N : Network V E} {D : Network F E} (M : N.ColoredDual D) {root : V} (P : Pair (M.nonroots root))
  (b : CycleClass P.next → Bool), (↑(P.orient b)).sign = (-1) ^ {c | b c = true}.card * P.sign
@sign_formula_concrete : ∀ {V : Type u_1} {E : Type u_2} {F : Type u_3} [inst : Fintype V] [inst_1 : Fintype E]
  [Fintype F] {N : Network V E} {D : Network F E} (M : N.ColoredDual D) {root : V} (P : Pair (M.nonroots root)),
  Even (Fintype.card (M.Black root) + Fintype.card (CycleClass P.next)) ∧
    P.sign = (-1) ^ ((Fintype.card (M.Black root) + Fintype.card (CycleClass P.next)) / 2 + P.ccwCount)
@sign_eq_I_pow_mul_phase_concrete : ∀ {V : Type u_1} {E : Type u_2} {F : Type u_3} [inst : Fintype V]
  [inst_1 : Fintype E] [Fintype F] {N : Network V E} {D : Network F E} (M : N.ColoredDual D) {root : V}
  (P : Pair (M.nonroots root)), ↑P.sign = Complex.I ^ Fintype.card (M.Black root) * phase (rawIndexSum P.left P.right)
@forest_pair_real : ∀ {V : Type u_1} {E : Type u_2} {F : Type u_3} [inst : Fintype V] [inst_1 : Fintype E] [Fintype F]
  {N : Network V E} {D : Network F E} (M : N.ColoredDual D) {root : V},
  Nonempty (Pair (M.nonroots root)) → ∃ P, ((M.system root).oppositeGraph P.right).IsAcyclic
@realSum_ne_zero_concrete : ∀ {V : Type u_1} {E : Type u_2} {F : Type u_3} [inst : Fintype V] [inst_1 : Fintype E]
  [Fintype F] {N : Network V E} {D : Network F E} (M : N.ColoredDual D) {root : V}
  (hex : Nonempty (Pair (M.nonroots root))) (α : E → ℝ),
  N.boundary α = Network.whiteCharge M.black root → realSum (M.weights α root) (Pair.minCycles hex) ≠ 0
@Devices.OutOrientation.card_edgeSet_add_sinks : ∀ {V : Type u_1} {G : SimpleGraph V} (o : Devices.OutOrientation G)
  [Finite V], Nat.card ↑G.edgeSet + Nat.card { v // o.out v = none } = Nat.card V
@Devices.OutOrientation.component_count : ∀ {V : Type u_1} {G : SimpleGraph V} (o : Devices.OutOrientation G)
  [Finite V],
  G.Connected →
    Nat.card ↑G.edgeSet + Nat.card { v // o.out v = none } = Nat.card V ∧
      Nat.card { v // o.out v = none } ≤ 1 ∧
        (Nat.card { v // o.out v = none } = 1 → G.IsTree) ∧
          (Nat.card { v // o.out v = none } = 0 →
            ¬G.IsAcyclic ∧ ∀ (x y : V), G.Adj x y → ¬G.IsBridge s(x, y) → (G.deleteEdges {s(x, y)}).IsTree)
@Devices.IsAcyclic.perfectMatching_unique : ∀ {V : Type u_1} [Finite V] {G : SimpleGraph V},
  G.IsAcyclic → ∀ {M M' : G.Subgraph}, M.IsPerfectMatching → M'.IsPerfectMatching → M = M'
