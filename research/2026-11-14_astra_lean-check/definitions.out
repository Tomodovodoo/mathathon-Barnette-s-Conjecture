def OAI.Barnette.MainStatement.{u} : Prop :=
∀ (V : Type u) [inst : Fintype V] [inst_1 : DecidableEq V] (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj],
  G.IsRegularOfDegree 3 →
    G.IsBipartite → OAI.Barnette.Planar G → OAI.Barnette.ThreeVertexConnected G → OAI.Barnette.HasHamiltonianCycle G
structure OAI.Barnette.TriangleSystem.{u_1, u_2} (A : Type u_1) (V : Type u_2) : Type (max u_1 u_2)
number of parameters: 2
fields:
  OAI.Barnette.TriangleSystem.vertex : A → Fin 3 → V
  OAI.Barnette.TriangleSystem.vertex_injective : ∀ (t : A), Function.Injective (self.vertex t)
  OAI.Barnette.TriangleSystem.edge_unique : ∀ (t u : A) (i j k l : Fin 3),
      i ≠ j → k ≠ l → self.vertex t i = self.vertex u k → self.vertex t j = self.vertex u l → t = u
constructor:
  OAI.Barnette.TriangleSystem.mk.{u_1, u_2} {A : Type u_1} {V : Type u_2} (vertex : A → Fin 3 → V)
    (vertex_injective : ∀ (t : A), Function.Injective (vertex t))
    (edge_unique :
      ∀ (t u : A) (i j k l : Fin 3), i ≠ j → k ≠ l → vertex t i = vertex u k → vertex t j = vertex u l → t = u) :
    OAI.Barnette.TriangleSystem A V
def OAI.Barnette.TriangleSystem.State.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} → OAI.Barnette.TriangleSystem A V → Set V → Type (max 0 u_1) :=
fun {A} {V} T X => { c // (Function.Injective fun t => T.vertex t (c t)) ∧ (Set.range fun t => T.vertex t (c t)) = X }
def OAI.Barnette.TriangleSystem.Partner.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} → (T : OAI.Barnette.TriangleSystem A V) → {X : Set V} → T.State X → T.State X → Prop :=
fun {A} {V} T {X} r s => ∀ (t : A), r.value t ≠ s.value t
def OAI.Barnette.TriangleSystem.Pair.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} → {T : OAI.Barnette.TriangleSystem A V} → Set V → Type (max 0 u_1) :=
fun {A} {V} {T} X => { rs // T.Partner rs.1 rs.2 }
def OAI.Barnette.TriangleSystem.oppositeGraph.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} → (T : OAI.Barnette.TriangleSystem A V) → {X : Set V} → T.State X → SimpleGraph V :=
fun {A} {V} T {X} s =>
  { Adj := fun v w => v ≠ w ∧ ∃ t i j, T.vertex t i = v ∧ T.vertex t j = w ∧ i ≠ ↑s t ∧ j ≠ ↑s t, symm := ⋯,
    loopless := ⋯ }
def OAI.Barnette.TriangleSystem.Pair.next.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} →
    {T : OAI.Barnette.TriangleSystem A V} → {X : Set V} → OAI.Barnette.TriangleSystem.Pair X → Equiv.Perm A :=
fun {A} {V} {T} {X} P => P.right.toEquiv.trans P.left.toEquiv.symm
def OAI.Barnette.CycleClass.{u_1} : {A : Type u_1} → Equiv.Perm A → Type u_1 :=
fun {A} p => Quotient (Equiv.Perm.SameCycle.setoid p)
def OAI.Barnette.TriangleSystem.Pair.Group.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} →
    {T : OAI.Barnette.TriangleSystem A V} → {X : Set V} → OAI.Barnette.TriangleSystem.Pair X → Type (max 0 u_1) :=
fun {A} {V} {T} {X} P => { Q // Q.third = P.third }
def OAI.Barnette.TriangleSystem.Pair.GroupIndex.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} → {T : OAI.Barnette.TriangleSystem A V} → {X : Set V} → Type u_1 :=
fun {A} {V} {T} {X} => ↑(Set.range OAI.Barnette.TriangleSystem.Pair.third)
def OAI.Barnette.TriangleSystem.Pair.GroupIndex.representative.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} →
    {T : OAI.Barnette.TriangleSystem A V} →
      {X : Set V} → OAI.Barnette.TriangleSystem.Pair.GroupIndex → OAI.Barnette.TriangleSystem.Pair X :=
fun {A} {V} {T} {X} d => Classical.choose ⋯
def OAI.Barnette.TriangleSystem.Pair.cycleSlope.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} →
    [Fintype A] →
      {T : OAI.Barnette.TriangleSystem A V} →
        {X : Set V} → (P : OAI.Barnette.TriangleSystem.Pair X) → (A → Fin 3 → ℝ) → OAI.Barnette.CycleClass P.next → ℝ :=
fun {A} {V} [Fintype A] {T} {X} P w c => ∑ t ∈ P.cycleFaces c, w t (↑P.right t) - ∑ t ∈ P.cycleFaces c, w t (↑P.left t)
def OAI.Barnette.TriangleSystem.Pair.minCycles.{u_1, u_2} : {A : Type u_1} →
  {V : Type u_2} →
    [Fintype A] →
      {T : OAI.Barnette.TriangleSystem A V} → {X : Set V} → Nonempty (OAI.Barnette.TriangleSystem.Pair X) → ℕ :=
fun {A} {V} [Fintype A] {T} {X} hex =>
  have this := ⋯;
  (Finset.image (fun d => Fintype.card (OAI.Barnette.CycleClass d.representative.next)) Finset.univ).min' ⋯
structure OAI.Barnette.Network.ColoredDual.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2} {F : Type u_3} [Fintype V]
  [Fintype E] (N : OAI.Barnette.Network V E) (D : OAI.Barnette.Network F E) : Type (max (max u_1 u_2) u_3)
number of parameters: 7
fields:
  OAI.Barnette.Network.ColoredDual.duality : N.Duality D
  OAI.Barnette.Network.ColoredDual.simple : N.Simple
  OAI.Barnette.Network.ColoredDual.dual_simple : D.Simple
  OAI.Barnette.Network.ColoredDual.cubic : N.graph.IsRegularOfDegree 3
  OAI.Barnette.Network.ColoredDual.black : V → Prop
  OAI.Barnette.Network.ColoredDual.coloring : ∀ (e : E), self.black (N.tail e) ↔ ¬self.black (N.head e)
  OAI.Barnette.Network.ColoredDual.face : (v : V) → D.Triangle (N.star v)
  OAI.Barnette.Network.ColoredDual.oriented : ∀ (v : V) (i : Fin 3),
      N.gradient (fun w => if w = v then 1 else 0) ((self.face v).edge i) =
        D.arcSign ((self.face v).edge i) ((self.face v).corner i)
constructor:
  OAI.Barnette.Network.ColoredDual.mk.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2} {F : Type u_3} [Fintype V]
    [Fintype E] {N : OAI.Barnette.Network V E} {D : OAI.Barnette.Network F E} (duality : N.Duality D)
    (simple : N.Simple) (dual_simple : D.Simple) (cubic : N.graph.IsRegularOfDegree 3) (black : V → Prop)
    (coloring : ∀ (e : E), black (N.tail e) ↔ ¬black (N.head e)) (face : (v : V) → D.Triangle (N.star v))
    (oriented :
      ∀ (v : V) (i : Fin 3),
        N.gradient (fun w => if w = v then 1 else 0) ((face v).edge i) =
          D.arcSign ((face v).edge i) ((face v).corner i)) :
    N.ColoredDual D
def OAI.Barnette.Network.ColoredDual.system.{u_1, u_2, u_3} : {V : Type u_1} →
  {E : Type u_2} →
    {F : Type u_3} →
      [inst : Fintype V] →
        [inst_1 : Fintype E] →
          {N : OAI.Barnette.Network V E} →
            {D : OAI.Barnette.Network F E} →
              (M : N.ColoredDual D) → (root : V) → OAI.Barnette.TriangleSystem (M.Black root) F :=
fun {V} {E} {F} [Fintype V] [Fintype E] {N} {D} M root =>
  { vertex := fun t => (M.face ↑t).corner, vertex_injective := ⋯, edge_unique := ⋯ }
def OAI.Barnette.Network.ColoredDual.nonroots.{u_1, u_2, u_3} : {V : Type u_1} →
  {E : Type u_2} →
    {F : Type u_3} →
      [inst : Fintype V] →
        [inst_1 : Fintype E] →
          {N : OAI.Barnette.Network V E} → {D : OAI.Barnette.Network F E} → N.ColoredDual D → V → Set F :=
fun {V} {E} {F} [Fintype V] [Fintype E] {N} {D} M root => (Set.range (M.face root).corner)ᶜ
structure OAI.Barnette.Network.Duality.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2} (N : OAI.Barnette.Network V E)
  [Fintype E] {F : Type u_3} (D : OAI.Barnette.Network F E) : Prop
number of parameters: 6
fields:
  OAI.Barnette.Network.Duality.connected : N.graph.Connected
  OAI.Barnette.Network.Duality.dual_connected : D.graph.Connected
  OAI.Barnette.Network.Duality.cycles_eq_cuts : N.boundary.ker = D.gradient.range
  OAI.Barnette.Network.Duality.dual_cycles_eq_cuts : D.boundary.ker = N.gradient.range
constructor:
  OAI.Barnette.Network.Duality.mk.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2} {N : OAI.Barnette.Network V E}
    [Fintype E] {F : Type u_3} {D : OAI.Barnette.Network F E} (connected : N.graph.Connected)
    (dual_connected : D.graph.Connected) (cycles_eq_cuts : N.boundary.ker = D.gradient.range)
    (dual_cycles_eq_cuts : D.boundary.ker = N.gradient.range) : N.Duality D
def OAI.Barnette.Network.whiteCharge.{u_1} : {V : Type u_1} → [Fintype V] → (V → Prop) → V → V → ℝ :=
fun {V} [Fintype V] black root v => (if black v then 0 else 1) - if v = root then ↑{w | ¬black w}.card else 0
def OAI.Barnette.phase : ℤ → ℂ :=
fun n => Complex.I ^ (n / 3)
