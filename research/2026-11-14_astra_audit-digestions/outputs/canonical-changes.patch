": "T1", "status": "established (LIT: 2026 preprint or its formalisation, unrefereed)", "links": [{"to": "m.step.A", "rel": "instance-of"}, {"to": "src.T", "rel": "cites"}, {"to": "wp.P", "rel": "supports"}, {"to": "x.R.x1", "rel": "refutes"}, {"to": "th.A.O", "rel": "generalizes"}], "source": "labyrinth"}, {"id": "c.A.c", "title": "criterion checked on all roots to 16 vertices", "statement": "Pair existence agrees with absence of a black-inner separating triangle at every root tested.", "where": ["research/2026-11-14_astra_limits/code/campaign.py 14 (1206 roots); research/2026-11-14_sol_route-constructive/VERIFICATION.md (77 runs); gt (all 7868 rooted instances up to 16 vertices against max-flow)"], "tags": ["step A"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "evidence", "tier": "T4", "status": "computed", "evidence": ["research/2026-11-14_astra_limits/code/campaign.py 14 (1206 roots); research/2026-11-14_sol_route-constructive/VERIFICATION.md (77 runs); gt (all 7868 rooted instances up to 16 vertices against max-flow)"], "links": [{"to": "m.step.A", "rel": "instance-of"}, {"to": "src.agent.lim", "rel": "cites"}, {"to": "src.agent.con", "rel": "cites"}, {"to": "src.agent.gt", "rel": "cites"}, {"to": "wp.P", "rel": "tests"}], "source": "labyrinth"}, {"id": "p.A.d", "title": "Li's Lemma 9 already gives the black inner boundary", "statement": "For a minimal deficient set all three cut edges have their black end inside, so Li's proof gives (iii) implies (ii) of T Theorem 1.2.", "where": ["research/2026-11-14_fable_dependency-graph/correspondence.md 3.7"], "tags": ["step A"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "established: proved here (unreviewed)", "review": {"state": "unreviewed", "date": "2026-11-14"}, "links": [{"to": "m.step.A", "rel": "instance-of"}, {"to": "src.agent.dep", "rel": "cites"}, {"to": "wp.P", "rel": "supports"}], "source": "labyrinth"}, {"id": "h.A.1", "title": "induction over