rel": "supports"}, {"to": "x.N.x2", "rel": "refutes"}], "source": "labyrinth"}, {"id": "p.D.5", "title": "tree matchings can be exponentially rare", "statement": "Gluing q hexagonal-prism duals into white faces gives 3^q states and 2^q tree matchings.", "where": ["research/2026-11-14_astra_limits/HYPOTHESES.md (rarity); code/rarity.py q <= 6; research/2026-11-14_fable_route-categorical/PROOF.md Prop. 6 (states, pairs and tree matchings multiply under insertion into a white face)"], "tags": ["step D"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "proof supplied (under review)", "review": {"state": "under-review", "date": "2026-11-14", "by": ["research/2026-11-14_sol_referee-structure"], "verdict": "proof in research/2026-11-14_astra_limits: pending (audit started 10:50 UTC). Not covered by that verdict: 2026-11-14_fable_route-categorical"}, "links": [{"to": "m.step.D", "rel": "instance-of"}, {"to": "src.agent.lim", "rel": "cites"}, {"to": "src.agent.cat", "rel": "cites"}, {"to": "wp.FP", "rel": "supports"}, {"to": "x.U.x3", "rel": "refutes"}], "source": "labyrinth"}, {"id": "k.D.6", "title": "a canonical forest pair", "statement": "Under a bijection from states to trinity arborescences, tree matchings have a tree description that singles one out.", "where": ["research/2026-11-14_fable_route-combinatorics/REPORT.md step 3"], "tags": ["step D"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "conjecture", "tier": "T5", "status": "open", "test": "Write the Hine-Kalman bijection on the 12-vertex class 6 example where every extremal rule fails, and look at the images of its 8 tree matchings.", "links": [{"to": "m.step.D", "rel": "instance-of"}, {"to": "src.agent.comb", "rel": "cites"}, {"to": "wp.FP", "rel": "suggests"}], "source": "labyrinth"}, {"id": "p.U.1", "title": "prescribed-degree spanning tree of H", "statement": "[y^{d*}] det L_H(y) is the number of tree matchings: a positive coefficient of the tree-degree polynomial. Existence would follow from a support theorem for that polynomial.", "where": ["research/2026-11-14_sol_machinery-literature/REFORMULATIONS.md 1, 4"], "tags": ["step U"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "proof supplied (unreviewed)", "review": {"state": "unreviewed", "date": "2026-11-14"}, "links": [{"to": "m.step.U", "rel": "instance-of"}, {"to": "src.agent.mach", "rel": "cites"}, {"to": "wp.FP", "rel": "supports"}], "source": "labyrinth"}, {"id": "p.U.2", "title": "label-transversal white trees", "statement": "Tree matchings are the spanning trees of the restricted white-face graph whose edge labels use every t and every v once. A doubly squarefree coefficient of a Laplacian determinant counts them, by Cauchy-Binet with all terms nonnegative.", "where": ["research/2026-11-14_astra_route-dimers/PROOF.md 5; research/2026-11-14_sol_route-algebra/PROOF.md 3"], "tags": ["step U"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "proof supplied (1 independent AI referee; human check pending)", "review": {"state": "refereed", "date": "2026-11-14", "by": ["research/2026-11-14_fable_referee-determinants"], "verdict": "proof in research/2026-11-14_astra_route-dimers: every refereed claim CORRECT, two wording fixes (REFEREE-constructive.md, REFEREE-dimers.md); li.py, the marked walk, the exchange walks and the trinity cofactors were not refereed; human check pending. Not covered by that verdict: 2026-11-14_sol_route-algebra"}, "links": [{"to": "m.step.U", "rel": "instance-of"}, {"to": "src.agent.dim", "rel": "cites"}, {"to": "src.agent.alg", "rel": "cites"}, {"to": "wp.FP", "rel": "supports"}], "source": "labyrinth"}, {"id": "p.U.3", "title": "three-matroid intersection", "statement": "A tree matching is a common basis of the stated three matroids. The natural triple is irredundant. This does not rule out a different two-matroid encoding or a min-max theorem.", "where": ["research/2026-11-14_sol_machinery-literature/REFORMULATIONS.md 6; research/2026-11-14_opus_route-graph-theory/PROOFS.md Section 1"], "tags": ["step U"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "proof supplied (under review)", "review": {"state": "under-review", "date": "2026-11-14", "by": ["research/2026-11-14_sol_referee-structure"], "verdict": "proof in research/2026-11-14_opus_route-graph-theory: pending (audit started 10:50 UTC). Not covered by that verdict: 2026-11-14_sol_machinery-literature"}, "links": [{"to": "m.step.U", "rel": "instance-of"}, {"to": "src.agent.mach", "rel": "cites"}, {"to": "src.agent.gt", "rel": "cites"}, {"to": "wp.FP", "rel": "supports"}], "source": "labyrinth"}, {"id": "p.U.4", "title": "unique partner: |det K_{B-s}| = 1", "statement": "Zeroing the entries of s in K_B gives a determinant equal to the number of partners up to sign. A tree matching is a state where it is 1.", "where": ["research/2026-11-14_sol_machinery-literature/REFORMULATIONS.md 2 (after T Prop. 2.1)"], "tags": ["step U"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "proof supplied (unreviewed)", "review": {"state": "unreviewed", "date": "2026-11-14"}, "links": [{"to": "m.step.U", "rel": "instance-of"}, {"to": "src.agent.mach", "rel": "cites"}, {"to": "wp.FP", "rel": "supports"}], "source": "labyrinth"}, {"id": "p.U.5", "title": "tree matchings = partnered Hamiltonian cycles", "statement": "Tree matchings are in bijection with the Hamiltonian cycles avoiding e0* whose state has a partner. So 3 #TM <= #HC(G).", "where": ["research/2026-11-14_fable_route-combinatorics/PROOF.md Prop. 7; research/2026-11-14_astra_limits/HYPOTHESES.md; research/2026-11-14_opus_route-graph-theory/PROOFS.md Thm 7.2 (explicit left inverse; image = partitions with acyclic white parent map)"], "tags": ["step U"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "proof supplied (1 independent AI referee; human check pending)", "review": {"state": "refereed", "date": "2026-11-14", "by": ["research/2026-11-14_astra_referee-combinatorics"], "verdict": "proof in research/2026-11-14_fable_route-combinatorics: FOLLOWS, with corrections to domain, normalisation and the scope of the negative conclusions (REFEREE.md); human check pending. Not covered by that verdict: 2026-11-14_astra_limits, 2026-11-14_opus_route-graph-theory"}, "links": [{"to": "m.step.U", "rel": "instance-of"}, {"to": "src.agent.comb", "rel": "cites"}, {"to": "src.agent.lim", "rel": "cites"}, {"to": "src.agent.gt", "rel": "cites"}, {"to": "wp.FP", "rel": "supports"}, {"to": "x.A.x1", "rel": "refutes"}], "source": "labyrinth"}, {"id": "p.U.6", "title": "rooted functional orientations; two-sided hypertrees", "statement": "Two more exact restatements of the target, as an orientation problem and as a simultaneous hypertree realisation.", "where": ["research/2026-11-14_sol_machinery-literature/REFORMULATIONS.md 5, 7"], "tags": ["step U"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "proof supplied (unreviewed)", "review": {"state": "unreviewed", "date": "2026-11-14"}, "links": [{"to": "m.step.U", "rel": "instance-of"}, {"to": "src.agent.mach", "rel": "cites"}, {"to": "wp.FP", "rel": "supports"}], "source": "labyrinth"}, {"id": "x.U.x1", "title": "matching matroid meets graphic matroid", "statement": "Treat the two endpoint constraints as one matroid and use Edmonds' two-matroid intersection.", "where": ["research/2026-11-14_sol_machinery-literature/REFORMULATIONS.md 6; research/2026-11-14_sol_route-constructive/data/other_candidates.json; research/2026-11-14_fable_referee-determinants/REFEREE-constructive.md"], "tags": ["step U"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "deadend", "tier": null, "status": "refuted", "lesson": "Matchings are not a matroid (augmentation fails on