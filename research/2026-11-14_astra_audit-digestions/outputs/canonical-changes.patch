abyrinth"}, {"id": "h.B.4", "title": "Grinberg count made rigid by a matching", "statement": "3(B - W) = 2l - h is a Grinberg balance in the dual; the bijection adds B = I + l.", "where": ["research/2026-11-14_opus_history-literature/WHAT-WAS-HARD.md 2"], "tags": ["step B"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "hunch", "tier": "T6", "status": "live", "vivid": "Places the one new lemma next to the oldest tool of the subject.", "test": "State Grinberg's formula for the dual disk and compare term by term.", "links": [{"to": "m.step.B", "rel": "instance-of"}, {"to": "src.agent.hist", "rel": "cites"}, {"to": "wp.DI", "rel": "suggests"}], "source": "labyrinth"}, {"id": "k.B.5", "title": "Gauss-Bonnet form for any cycle", "statement": "For a state s and a simple cycle C avoiding the roots, B - W = 2m - h + 2, with m the boundary vertices whose matched face lies inside. The topology agent reports the orientation-free form W = B + 1 as proved (B.6); the status of this exact formula is in topo/ROUTES.md.", "where": ["research/2026-11-14_opus_route-topology/PREDICTIONS.md P2"], "tags": ["step B"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "conjecture", "tier": "T5", "status": "open", "test": "Outcome pending in topo/ROUTES.md.", "links": [{"to": "m.step.B", "rel": "instance-of"}, {"to": "src.agent.topo", "rel": "cites"}, {"to": "wp.DI", "rel": "suggests"}], "source": "labyrinth"}, {"id": "th.C.O", "title": "phase i^J", "statement": "J = (1/3) sum of delta(r(t), s(t)) is an integer; both reversals change J by 2.", "where": ["O (5.1), Lemma 5.2"], "tags": ["step C"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T1", "status": "established (LIT: 2026 preprint or its formalisation, unrefereed)", "links": [{"to": "m.step.C", "rel": "instance-of"}, {"to": "src.O", "rel": "cites"}, {"to": "wp.M", "rel": "supports"}], "source": "labyrinth"}, {"id": "th.C.L", "title": "(-1)^cw from local turns", "statement": "cw' = 