ng)", "review": {"state": "refereed", "date": "2026-11-14", "by": ["research/2026-11-14_astra_referee-combinatorics"], "verdict": "proof in research/2026-11-14_fable_route-combinatorics: FOLLOWS, with corrections to domain, normalisation and the scope of the negative conclusions (REFEREE.md); human check pending. Not covered by that verdict: 2026-11-14_astra_limits"}, "links": [{"to": "m.step.F", "rel": "instance-of"}, {"to": "src.agent.lim", "rel": "cites"}, {"to": "src.agent.comb", "rel": "cites"}, {"to": "wp.JC", "rel": "supports"}], "source": "labyrinth"}, {"id": "c.F.c", "title": "recovery checked on every tree matching", "statement": "Every selected P is a two-component forest and both sides induce trees.", "where": ["research/2026-11-14_sol_route-constructive/VERIFICATION.md (744 recoveries); research/2026-11-14_astra_limits/code/campaign.py 14 (3618 certificates)"], "tags": ["step F"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "evidence", "tier": "T4", "status": "computed", "evidence": ["research/2026-11-14_sol_route-constructive/VERIFICATION.md (744 recoveries); research/2026-11-14_astra_limits/code/campaign.py 14 (3618 certificates)"], "links": [{"to": "m.step.F", "rel": "instance-of"}, {"to": "src.agent.con", "rel": "cites"}, {"to": "src.agent.lim", "rel": "cites"}, {"to": "wp.JC", "rel": "tests"}], "source": "labyrinth"}, {"id": "k.F.4", "title": "remove a leaf of the white tree", "statement": "Removing a leaf of the white tree with the black face whose spoke it crosses leaves a rooted triangulation with a tree matching, and the cycle of the larger graph is a local detour.", "where": ["research/2026-11-14_fable_dependency-graph/skeleton.md F1"], "tags": ["step F"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "conjecture", "tier": "T5", "status": "open", "test": "Implement leaf removal on the trees produced by dep/scripts/check_nodes.py and check validity of the smaller object.", "links": [{"to": "m.step.F", "rel": "instance-of"}, {"to": "src.agent.dep", "rel": "cites"}, {"to": "wp.JC", "rel": "suggests"}], "source": "labyrinth"}, {"id": "h.F.5", "title": "a potential along the selected out-edges", "statement": "Follow selected out-edges from a vertex to a root; a quantity that decreases along the walk proves connectivity.", "where": ["research/2026-11-14_fable_dependency-graph/skeleton.md F2"], "tags": ["step F"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "hunch", "tier": "T6", "status": "live", "vivid": "A third proof of the last step, perhaps the shortest.", "test": "Compute the change of white-tree depth along each selected out-edge.", "links": [{"to": "m.step.F", "rel": "instance-of"}, {"to": "src.agent.dep", "rel": "cites"}, {"to": "wp.JC", "rel": "suggests"}], "source": "labyrinth"}, {"id": "th.J2.1", "title": "Jordan curve theorem and Euler count", "statement": "Each side of the cycle induces a connected acyclic subgraph of T.", "where": ["O end of 6.2; T Lemma 7.1; APSW Lemma 5"], "tags": ["step J2"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T1", "status": "established (LIT: published)", "links": [{"to": "m.step.J2", "rel": "instance-of"}, {"to": "src.O", "rel": "cites"}, {"to": "src.T", "rel": "cites"}, {"to": "wp.2T", "rel": "supports"}], "source": "labyrinth"}, {"id": "th.J2.2", "title": "Li does not need the trees", "statement": "Li goes from P to the Hamiltonian cycle and glues cycles.", "where": ["L Section 5"], "tags": ["step J2"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "established (LIT: 2026 preprint or its formalisation, unrefereed)", "review": {"state": "unreviewed", "verdict": "Supplied preprint or formal source; no journal review claimed."}, "links": [{"to": "m.step.J2", "rel": "instance-of"}, {"to": "src.L", "rel": "cites"}, {"to": "wp.2T", "rel": "supports"}], "source": "labyrinth"}, {"id": "th.G.O", "title": "induction with a prescribed cap edge", "statemen