tel 2005"], "tags": ["step G"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T1", "status": "established (LIT: published)", "links": [{"to": "m.step.G", "rel": "instance-of"}, {"to": "wp.GL", "rel": "supports"}], "source": "labyrinth"}, {"id": "p.G.1", "title": "every separating triangle has one black side", "statement": "The state method needs no cut exactly when t0 is on the black side of every separating triangle. Changing the root or swapping colours can avoid cuts, not always.", "where": ["research/2026-11-14_fable_dependency-graph/audit-trees.md T-F1; research/2026-11-14_fable_dependency-graph/skeleton.md G1"], "tags": ["step G"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "established: proved here (unreviewed)", "review": {"state": "unreviewed", "date": "2026-11-14"}, "links": [{"to": "m.step.G", "rel": "instance-of"}, {"to": "src.agent.dep", "rel": "cites"}, {"to": "wp.GL", "rel": "supports"}], "source": "labyrinth"}, {"id": "p.G.2", "title": "the gluing needs the same-label edge", "statement": "Trees of the two pieces meet in one vertex or one edge; prescribing the cap edge supplies the agreement. The smallest separating example has 9 vertices.", "where": ["research/2026-11-14_astra_limits/HYPOTHESES.md (separating triangles)"], "tags": ["step G"], "created": "2026-11-14", "updated": "2026-11-14", "kind": "theorem", "tier": "T2", "status": "established: proved here (under review)", "review": {"state": "under-review", "date": "2026-11-14", "by": ["research/2026-11-14_sol_referee-structure"], "verdict": "proof in research/2026-11-14_astra_limits: pending (audit started 10:50 UTC)"}, "links": [{"to": "m.step.G", "rel": "instance-of"}, {"to": "src.agent.lim", "rel": "cites"}, {"to": "wp.GL", "rel": "supports"}], "source": "labyrinth"}, {"id": "x.G.x1", "title": "prescribe whatever each cut needs", "statement": "Strengthen the induction hypothesis to an arbitrary set of prescribed