 "lem:difference" [label="Lemma 4.7\nfinite difference [Lean: here]", fillcolor="#f1a340", fontcolor="black", color="#b15928", penwidth=2.2, style="rounded,filled"];
 "prop:good" [label="Prop. 4.8\na pair gives a good state", fillcolor="#7fbf7b", fontcolor="black", color="#b15928", penwidth=2.2, style="rounded,filled"];
 "rem:other-sums" [label="Remark 4.10\nother sums", fillcolor="#f1a340", fontcolor="black", color="#b15928", penwidth=2.2, style="rounded,filled,dashed"];
 "txt:flow" [label="Text \ncapacity => pair (max-flow)", fillcolor="#1b7837", fontcolor="white", color="#e31a1c", penwidth=2.2, style="rounded,filled"];
