 "lem:cancel" [label="Lemma 4.5\ncancellation", fillcolor="#7fbf7b", fontcolor="black", color="#b15928", penwidth=2.2, style="rounded,filled"];
 "txt:heights" [label="Text \nheights along face paths", fillcolor="#7fbf7b", fontcolor="black", color="#b15928", penwidth=2.2, style="rounded,filled"];
