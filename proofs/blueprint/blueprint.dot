digraph blueprint {
 rankdir=BT; newrank=true; nodesep=0.25; ranksep=0.45; splines=true;
 node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.08,0.04"];
 edge [color="#555555", arrowsize=0.6];
 labelloc=t; fontname="Helvetica"; fontsize=14;
 label="Merged paper (paper/main/barnette.tex): uses-graph, transitive reduction. Arrow A -> B: the proof of B uses A.\nFill: dark green = machine-checked counterpart (exact); light green = machine-checked in different form (translation not checked); orange = refereed by a second model only. Dashed border: not needed for Theorem 1.1.";
 subgraph legend { rank=sink; node [shape=plaintext, style="", fontsize=10];
  lg [label=<<TABLE BORDER="0" CELLSPACING="2"><TR><TD BORDER="2" COLOR="#000000">  </TD><TD ALIGN="LEFT">border: Sec 1 Introduction</TD></TR><TR><TD BORDER="2" COLOR="#1f78b4">  </TD><TD ALIGN="LEFT">border: Sec 2 The dual and the target</TD></TR><TR><TD BORDER="2" COLOR="#6a3d9a">  </TD><TD ALIGN="LEFT">border: Sec 3 Corner choices and the tree of faces</TD></TR><TR><TD BORDER="2" COLOR="#b15928">  </TD><TD ALIGN="LEFT">border: Sec 4 Pairs of states</TD></TR><TR><TD BORDER="2" COLOR="#e31a1c">  </TD><TD ALIGN="LEFT">border: Sec 5 The first pair</TD></TR><TR><TD BORDER="2" COLOR="#33a02c">  </TD><TD ALIGN="LEFT">border: Sec 6 Separating triangles</TD></TR><TR><TD BORDER="2" COLOR="#999999">  </TD><TD ALIGN="LEFT">border: Sec 7 Remarks</TD></TR></TABLE>>]; }
 "thm:main" [label="Theorem 1.1\nHamiltonian cycle avoiding e", fillcolor="#7fbf7b", fontcolor="black", color="#000000", penwidth=2.2, style="rounded,filled"];
 "lem:dual" [label="Lemma 2.1\nthe dual is a coloured triangulation", fillcolor="#7fbf7b", fontcolor="black", color="#1f78b4", penwidth=2.2, style="rounded,filled"];
 "txt:two-faces" [label="Text \ntwo faces share <= 1 side", fillcolor="#7fbf7b", fontcolor="black", color="#1f78b4", penwidth=2.2, style="rounded,filled"];
 "lem:connected" [label="Lemma 2.2\nfaces bounded by cycles => connected", fillcolor="#f1a340", fontcolor="black", color="#1f78b4", penwidth=2.2, style="rounded,filled"];
 "eq:counts" [label="Eq. (2.3)\nk black, k white, 3k edges, k+2 vertices", fillcolor="#7fbf7b", fontcolor="black", color="#1f78b4", penwidth=2.2, style="rounded,filled"];
 "def:selection" [label="Def. 2.4\nselection", fillcolor="#7fbf7b", fontcolor="black", color="#1f78b4", penwidth=2.2, style="rounded,filled"];
 "lem:duality.1" [label="Lemma 2.5(1)\ncycle in N => dual disconnected", fillcolor="#7fbf7b", fontcolor="black", color="#1f78b4", penwidth=2.2, style="rounded,filled"];
 "lem:duality.2" [label="Lemma 2.5(2)\nN acyclic => dual connected", fillcolor="#7fbf7b", fontcolor="black", color="#1f78b4", penwidth=2.2, style="rounded,filled"];
