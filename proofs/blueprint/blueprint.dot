 "lem:cap" [label="Lemma 6.1\ncaps", fillcolor="#7fbf7b", fontcolor="black", color="#33a02c", penwidth=2.2, style="rounded,filled"];
 "thm:T" [label="Theorem 6.2\nacyclic selection containing e0", fillcolor="#7fbf7b", fontcolor="black", color="#33a02c", penwidth=2.2, style="rounded,filled"];
 "rem:which" [label="Remark Sec 7\nwhich HCs arise", fillcolor="#f1a340", fontcolor="black", color="#999999", penwidth=2.2, style="rounded,filled,dashed"];
 "rem:poly" [label="Remark Sec 7\npolynomial F(w)", fillcolor="#f1a340", fontcolor="black", color="#999999", penwidth=2.2, style="rounded,filled,dashed"];
