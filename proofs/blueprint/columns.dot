digraph columns {
 graph [fontname="Helvetica", labelloc=t, fontsize=14, label="Five-column correspondence, one row per waypoint\nColours as in blueprint.pdf: dark green = machine-checked counterpart exact; light green = counterpart in different form; orange = refereed by a second model only; red = unrefereed. Lean column: dark green = declaration."];
