\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Object 1 of the table: pair 0 with the tokens $5{:}0$ and $6{:}7$. Left: the whole triangulation, with the cycle cover $D$ in blue. Right: the same picture enlarged. Thin grey segments inside black triangles are selected spokes. Dashed lines are the rays from $w_5$ and $w_6$, in the direction that is vertical in the exact layout. Each black dot is a marked crossing of a ray with a thick spoke. Both tokens lie on the 7-cycle, so the triangle at the upper left is unmarked.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:marked}{{1}{9}{Object 1 of the table: pair 0 with the tokens $5{:}0$ and $6{:}7$. Left: the whole triangulation, with the cycle cover $D$ in blue. Right: the same picture enlarged. Thin grey segments inside black triangles are selected spokes. Dashed lines are the rays from $w_5$ and $w_6$, in the direction that is vertical in the exact layout. Each black dot is a marked crossing of a ray with a thick spoke. Both tokens lie on the 7-cycle, so the triangle at the upper left is unmarked}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The second map moves a token. Left: object 2 of the table, pair 0 with the tokens $5{:}0$ and $16{:}11$, black dots. The triangle carries $16{:}11$, so every cycle is marked. The point $w_5$ is outside the 7-cycle, and its ray meets that cycle twice, at the selected spokes of $t_0$ and $t_7$. Right: the image, object 6. The token has moved along the ray to the partner crossing. In each panel the hollow dot is the partner of the marked crossing on that ray. Both spokes belong to $s$, so no cycle is reversed. The two spokes cross the ray in opposite directions, and the sign changes from $-$ to $+$. On object 1 of Figure\nonbreakingspace \ref {fig:marked} the second map instead reverses the unmarked triangle and moves no token.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:second}{{2}{9}{The second map moves a token. Left: object 2 of the table, pair 0 with the tokens $5{:}0$ and $16{:}11$, black dots. The triangle carries $16{:}11$, so every cycle is marked. The point $w_5$ is outside the 7-cycle, and its ray meets that cycle twice, at the selected spokes of $t_0$ and $t_7$. Right: the image, object 6. The token has moved along the ray to the partner crossing. In each panel the hollow dot is the partner of the marked crossing on that ray. Both spokes belong to $s$, so no cycle is reversed. The two spokes cross the ray in opposite directions, and the sign changes from $-$ to $+$. On object 1 of Figure~\ref {fig:marked} the second map instead reverses the unmarked triangle and moves no token}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Drawing-free marks on the same triangulation. Each row is a tree path from its white face to the outer face $f_4$. Squares are bounded black faces; circles are white faces or the outer face. A thick green square is a marked step. Labels give the turned corner and its turn sign; the selected corner equals the turned corner at every marked step. Face IDs follow \texttt  {running.json}. The signs are those of the note's layout, the mirror image of the main paper's drawing, where the same turns have $\kappa =-1$.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:paths}{{3}{10}{Drawing-free marks on the same triangulation. Each row is a tree path from its white face to the outer face $f_4$. Squares are bounded black faces; circles are white faces or the outer face. A thick green square is a marked step. Labels give the turned corner and its turn sign; the selected corner equals the turned corner at every marked step. Face IDs follow \texttt {running.json}. The signs are those of the note's layout, the mirror image of the main paper's drawing, where the same turns have $\kappa =-1$}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The first map on class 6, root 8, with 12 vertices, where $m=1$. The second state and the token, the thick spoke of $t_0$ crossed by the ray of $w_3$, stay fixed. The first state changes on the faces of one cycle of $Q_s$, so the blue arrows of $D$ differ between the two panels.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:first}{{4}{10}{The first map on class 6, root 8, with 12 vertices, where $m=1$. The second state and the token, the thick spoke of $t_0$ crossed by the ray of $w_3$, stay fixed. The first state changes on the faces of one cycle of $Q_s$, so the blue arrows of $D$ differ between the two panels}{figure.4}{}}
